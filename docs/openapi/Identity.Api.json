  "components": {
    "schemas": {
      "InvitationRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "type": "string",
            "format": "email"
          }
        }
      },
      "SetEnabledRequest": {
        "required": [
          "enabled"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "SetRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "runner",
              "coach",
              "admin"
            ],
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "InvitationEndpoints"
    },
    {
      "name": "AdminUserEndpoints"
    },
    {
