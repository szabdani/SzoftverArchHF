  "components": {
    "schemas": {
      "GoalRequest": {
        "required": [
          "type",
          "targetDate"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/GoalType"
          },
          "distanceKm": {
            "maximum": 500,
            "minimum": 0.1,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "targetDate": {
            "type": "string",
            "format": "date"
          },
          "targetTime": {
            "pattern": "^(?:00:(?:0[1-9]|[1-5][0-9]):[0-5][0-9]|(?:0[1-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9])$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GoalType": {
        "enum": [
          "fiveK",
          "tenK",
          "halfMarathon",
          "marathon",
          "custom"
        ]
      },
      "PlannedWorkoutRequest": {
        "required": [
          "date",
          "type",
          "targetRpe"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "$ref": "#/components/schemas/WorkoutType"
          },
          "plannedDistanceKm": {
            "maximum": 100,
            "minimum": 0.1,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "plannedDuration": {
            "pattern": "^(?:00:(?:0[1-9]|[1-5][0-9]):[0-5][0-9]|0[1-9]:[0-5][0-9]:[0-5][0-9]|10:00:00)$",
            "type": [
              "null",
              "string"
            ]
          },
          "targetRpe": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PlanRequest": {
        "required": [
          "name",
          "startDate",
          "endDate",
          "linkActiveGoal"
        ],
        "type": "object",
        "properties": {
          "runnerId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "linkActiveGoal": {
            "type": "boolean"
          }
        }
      },
      "WorkoutRequest": {
        "required": [
          "date",
          "type",
          "distanceKm",
          "duration",
          "rpe"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "$ref": "#/components/schemas/WorkoutType"
          },
          "distanceKm": {
            "maximum": 100,
            "minimum": 0.1,
            "type": "number",
            "format": "double"
          },
          "duration": {
            "pattern": "^(?:00:(?:0[1-9]|[1-5][0-9]):[0-5][0-9]|0[1-9]:[0-5][0-9]:[0-5][0-9]|10:00:00)$",
            "type": "string"
          },
          "avgHeartRate": {
            "maximum": 220,
            "minimum": 40,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "elevationGainM": {
            "maximum": 5000,
            "minimum": 0,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "rpe": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "plannedWorkoutId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "WorkoutType": {
        "enum": [
          "easy",
          "recovery",
          "tempo",
          "interval",
          "long",
          "race"
        ]
      }
    }
  },
  "tags": [
