  "components": {
    "schemas": {
      "ActiveGoalResponse": {
        "required": [
          "goal",
          "weeksRemaining",
          "recentWorkouts"
        ],
        "type": "object",
        "properties": {
          "goal": {
            "$ref": "#/components/schemas/GoalResponse"
          },
          "weeksRemaining": {
            "type": "integer",
            "format": "int32"
          },
          "recentWorkouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkoutResponse"
            }
          }
        }
      },
      "GoalRequest": {
        "required": [
          "type",
          "targetDate"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/GoalType"
          },
          "distanceKm": {
            "maximum": 500,
            "minimum": 0.1,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "targetDate": {
            "type": "string",
            "format": "date"
          },
          "targetTime": {
            "pattern": "^(?:00:(?:0[1-9]|[1-5][0-9]):[0-5][0-9]|0[1-9]:[0-5][0-9]:[0-5][0-9]|10:00:00)$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GoalResponse": {
        "required": [
          "id",
          "runnerId",
          "type",
          "distanceKm",
          "targetDate",
          "isActive",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "runnerId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/GoalType"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          },
          "targetDate": {
            "type": "string",
            "format": "date"
          },
          "targetTime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "archivedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "GoalType": {
        "enum": [
          "fiveK",
          "tenK",
          "halfMarathon",
          "marathon",
          "custom"
        ]
      },
      "HttpValidationProblemDetails": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PlannedWorkoutRequest": {
        "required": [
          "date",
          "type",
          "targetRpe"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "$ref": "#/components/schemas/WorkoutType"
          },
          "plannedDistanceKm": {
            "maximum": 100,
            "minimum": 0.1,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "plannedDuration": {
            "pattern": "^(?:00:(?:0[1-9]|[1-5][0-9]):[0-5][0-9]|0[1-9]:[0-5][0-9]:[0-5][0-9]|10:00:00)$",
            "type": [
              "null",
              "string"
            ]
          },
          "targetRpe": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PlannedWorkoutResponse": {
        "required": [
          "id",
          "planId",
          "runnerId",
          "date",
          "type",
          "targetRpe",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "runnerId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "$ref": "#/components/schemas/WorkoutType"
          },
          "plannedDistanceKm": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "plannedDuration": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          },
          "targetRpe": {
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/PlannedWorkoutStatus"
          },
          "workoutId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "PlannedWorkoutStatus": {
        "enum": [
          "planned",
          "completed",
          "missed"
        ]
      },
      "PlanRequest": {
        "required": [
          "name",
          "startDate",
          "endDate",
          "linkActiveGoal"
        ],
        "type": "object",
        "properties": {
          "runnerId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "linkActiveGoal": {
            "type": "boolean"
          }
        }
      },
      "PlanResponse": {
        "required": [
          "id",
          "runnerId",
          "createdById",
          "name",
          "startDate",
          "endDate",
          "createdAt",
          "workouts"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "runnerId": {
            "type": "string",
            "format": "uuid"
          },
          "createdById": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "goalId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "workouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlannedWorkoutResponse"
            }
          }
        }
      },
      "WorkoutRequest": {
        "required": [
          "date",
          "type",
          "distanceKm",
          "duration",
          "rpe"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "$ref": "#/components/schemas/WorkoutType"
          },
          "distanceKm": {
            "maximum": 100,
            "minimum": 0.1,
            "type": "number",
            "format": "double"
          },
          "duration": {
            "pattern": "^(?:00:(?:0[1-9]|[1-5][0-9]):[0-5][0-9]|0[1-9]:[0-5][0-9]:[0-5][0-9]|10:00:00)$",
            "type": "string"
          },
          "avgHeartRate": {
            "maximum": 220,
            "minimum": 40,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "elevationGainM": {
            "maximum": 5000,
            "minimum": 0,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "rpe": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "plannedWorkoutId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
