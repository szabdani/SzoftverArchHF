{
  "realm": "futoedzes",
  "displayName": "Futóedzés-tervező",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "runner",
        "description": "Futó"
      },
      {
        "name": "coach",
        "description": "Edző"
      },
      {
        "name": "admin",
        "description": "Adminisztrátor"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-futoedzes",
        "description": "Új felhasználó alapértelmezett szerepkörei: futó.",
        "composite": true,
        "composites": {
          "realm": [
            "runner",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-futoedzes"
  },
  "clients": [
    {
      "clientId": "futoedzes-frontend",
      "name": "Futóedzés frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "futoedzes-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "futoedzes-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "futoedzes-identity-admin",
      "name": "Identity szolgáltatás (felhasználókezelés)",
      "description": "Az Identity.Api ezzel a service accounttal hívja a Keycloak Admin API-t (UC16).",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "futoedzes-identity-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles", "kc-admin-api"]
    }
  ],
  "users": [
    {
      "username": "admin@futoedzes.local",
      "email": "admin@futoedzes.local",
      "emailVerified": true,
      "enabled": true,
